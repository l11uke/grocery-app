[Unit]
Description=Grocery receipt tracker
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/grocery-app
EnvironmentFile=/home/admin/grocery-app/.env
ExecStart=/home/admin/grocery-app/venv/bin/python /home/admin/grocery-app/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
